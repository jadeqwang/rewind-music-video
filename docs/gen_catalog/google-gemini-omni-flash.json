{
 "model_id": "google/gemini-omni-flash",
 "name": "Gemini Omni Flash",
 "task": "Text-to-Video",
 "description": "Preview high-performance multimodal video generation and editing model with conversational controls and generated audio.",
 "pricing": {
  "Input text tokens (per 1M)": 1.5,
  "Input image tokens (per 1M)": 1.5,
  "Input audio tokens (per 1M)": 1.5,
  "Input video tokens (per 1M)": 1.5,
  "output_text_tokens": 9,
  "Reasoning tokens (per 1M)": 9,
  "output_video_tokens": 17.5,
  "Default (per second)": 1.5
 },
 "metadata": {
  "Audio Generation": "Yes",
  "Input Modalities": "Text, image, audio, video",
  "Resolutions": "360p, 720p, 1080p, 4k"
 },
 "schema": {
  "input": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "text": {
     "description": "Text prompt or editing instruction",
     "type": "string"
    },
    "image": {
     "description": "First-frame or primary reference image",
     "type": "string"
    },
    "last_frame": {
     "description": "Last-frame reference image",
     "type": "string"
    },
    "reference_images": {
     "maxItems": 10,
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "video": {
     "description": "Reference video for editing or extension",
     "type": "string"
    },
    "audio": {
     "description": "Reference audio input",
     "type": "string"
    },
    "previous_interaction_id": {
     "type": "string"
    },
    "aspect_ratio": {
     "type": "string",
     "enum": [
      "16:9",
      "9:16"
     ]
    },
    "resolution": {
     "type": "string",
     "enum": [
      "360p",
      "720p",
      "1080p",
      "4k"
     ]
    }
   },
   "additionalProperties": false
  },
  "output": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "video": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^data:.*"
      },
      {
       "type": "string",
       "format": "uri"
      }
     ]
    }
   },
   "required": [
    "video"
   ],
   "additionalProperties": false
  }
 },
 "examples": [
  {
   "name": "Underwater reef",
   "input": {
    "text": "A school of silver fish moving through a sunlit coral reef, slow cinematic tracking shot with drifting particles.",
    "aspect_ratio": "16:9",
    "resolution": "720p"
   }
  },
  {
   "name": "Breakfast robot",
   "input": {
    "text": "A friendly home robot preparing breakfast in a bright modern kitchen, gentle handheld camera movement.",
    "aspect_ratio": "9:16",
    "resolution": "720p"
   }
  },
  {
   "name": "Desert train",
   "input": {
    "text": "A vintage train crossing a vast desert at golden hour, dust glowing in the sunset as the camera sweeps alongside.",
    "aspect_ratio": "16:9",
    "resolution": "1080p"
   }
  },
  {
   "name": "Northern lights",
   "input": {
    "text": "Colorful northern lights dancing above a frozen lake, a small cabin glowing warmly in the foreground.",
    "aspect_ratio": "16:9",
    "resolution": "360p"
   }
  }
 ]
}