{
 "model_id": "xai/grok-imagine-video-1.5-preview",
 "name": "Grok Imagine Video 1.5 Preview",
 "task": "Image-to-Video",
 "description": "xAI's next-generation video generation model. Generates, edits, and extends videos from text and image inputs. Supports multiple aspect ratios and resolutions with improved quality over the previous generation.",
 "pricing": {
  "Default (per second)": 0.08,
  "@480p (per second)": 0.08,
  "@720p (per second)": 0.14
 },
 "metadata": {
  "Aspect Ratios": "1:1, 16:9, 9:16, 4:3, 3:4, 3:2, 2:3",
  "Input Modalities": "Text, Image, Video",
  "Max Duration": "15 seconds",
  "Resolutions": "480p, 720p"
 },
 "schema": {
  "input": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "_operation": {
     "type": "string",
     "enum": [
      "generate",
      "edit",
      "extend"
     ]
    },
    "prompt": {
     "type": "string"
    },
    "duration": {
     "type": "integer",
     "minimum": 1,
     "maximum": 15
    },
    "aspect_ratio": {
     "type": "string",
     "enum": [
      "1:1",
      "16:9",
      "9:16",
      "4:3",
      "3:4",
      "3:2",
      "2:3"
     ]
    },
    "resolution": {
     "type": "string",
     "enum": [
      "480p",
      "720p"
     ]
    },
    "size": {
     "type": "string",
     "enum": [
      "848x480",
      "1696x960",
      "1280x720",
      "1920x1080"
     ]
    },
    "image": {
     "type": "object",
     "properties": {
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "additionalProperties": false
    },
    "video": {
     "type": "object",
     "properties": {
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "additionalProperties": false
    },
    "reference_images": {
     "maxItems": 10,
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "url": {
        "type": "string"
       }
      },
      "required": [
       "url"
      ],
      "additionalProperties": false
     }
    },
    "output": {
     "type": "object",
     "properties": {
      "upload_url": {
       "type": "string"
      }
     },
     "required": [
      "upload_url"
     ],
     "additionalProperties": false
    },
    "user": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "output": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "video": {
     "type": "string"
    }
   },
   "required": [
    "video"
   ],
   "additionalProperties": false
  }
 },
 "examples": [
  {
   "name": "Image to video",
   "input": {
    "prompt": "Generate a slow and serene time-lapse",
    "image": {
     "url": "https://docs.x.ai/assets/api-examples/video/milkyway-still.png"
    },
    "duration": 12
   }
  }
 ]
}