{
 "model_id": "elevenlabs/music-v2",
 "name": "ElevenLabs Music v2",
 "task": "Music Generation",
 "description": "ElevenLabs Music v2 composes songs and instrumental tracks from a prompt or detailed composition plan.",
 "pricing": {
  "output_audio_seconds": 0.0025,
  "Default (per second)": 0.0025
 },
 "metadata": {
  "Controls": "Prompt, duration, seed, instrumental mode",
  "Max Duration": "Up to 10 minutes",
  "Output Formats": "MP3, PCM, Opus, u-law, A-law"
 },
 "schema": {
  "input": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "prompt": {
     "type": "string",
     "minLength": 1
    },
    "composition_plan": {
     "type": "object",
     "properties": {
      "chunks": {
       "minItems": 1,
       "type": "array",
       "items": {
        "anyOf": [
         {
          "type": "object",
          "properties": {
           "text": {
            "type": "string",
            "minLength": 1
           },
           "duration_ms": {
            "type": "integer",
            "minimum": 3000,
            "maximum": 120000
           },
           "positive_styles": {
            "minItems": 1,
            "type": "array",
            "items": {
             "type": "string"
            }
           },
           "negative_styles": {
            "type": "array",
            "items": {
             "type": "string"
            }
           },
           "context_adherence": {
            "type": "string",
            "enum": [
             "low",
             "medium",
             "high"
            ]
           },
           "conditioning_ref": {
            "type": "object",
            "properties": {
             "song_id": {
              "type": "string",
              "minLength": 1
             },
             "range": {
              "type": "object",
              "properties": {
               "start_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
               },
               "end_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
               }
              },
              "required": [
               "start_ms",
               "end_ms"
              ],
              "additionalProperties": false
             }
            },
            "required": [
             "song_id",
             "range"
            ],
            "additionalProperties": false
           },
           "condition_strength": {
            "type": "string",
            "enum": [
             "low",
             "medium",
             "high",
             "xhigh"
            ]
           }
          },
          "required": [
           "text",
           "duration_ms",
           "positive_styles"
          ],
          "additionalProperties": false
         },
         {
          "type": "object",
          "properties": {
           "song_id": {
            "type": "string",
            "minLength": 1
           },
           "range": {
            "type": "object",
            "properties": {
             "start_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
             },
             "end_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
             }
            },
            "required": [
             "start_ms",
             "end_ms"
            ],
            "additionalProperties": false
           }
          },
          "required": [
           "song_id",
           "range"
          ],
          "additionalProperties": false
         }
        ]
       }
      }
     },
     "required": [
      "chunks"
     ],
     "additionalProperties": false
    },
    "music_length_ms": {
     "type": "integer",
     "minimum": 3000,
     "maximum": 600000
    },
    "output_format": {
     "type": "string",
     "enum": [
      "auto",
      "mp3_48000_128",
      "mp3_48000_192",
      "mp3_48000_240",
      "mp3_48000_320",
      "mp3_22050_32",
      "mp3_24000_48",
      "mp3_44100_32",
      "mp3_44100_64",
      "mp3_44100_96",
      "mp3_44100_128",
      "mp3_44100_192",
      "opus_48000_32",
      "opus_48000_64",
      "opus_48000_96",
      "opus_48000_128",
      "opus_48000_192"
     ]
    },
    "seed": {
     "type": "integer",
     "minimum": 0,
     "maximum": 4294967295
    },
    "force_instrumental": {
     "type": "boolean"
    },
    "store_for_inpainting": {
     "type": "boolean"
    },
    "sign_with_c2pa": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "output": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "audio": {
     "type": "string",
     "description": "URL to the generated music file."
    }
   },
   "required": [
    "audio"
   ],
   "additionalProperties": false
  }
 },
 "examples": [
  {
   "name": "Cinematic Instrumental",
   "input": {
    "prompt": "A warm cinematic ambient track with soft piano, subtle strings, and a hopeful mood",
    "music_length_ms": 30000,
    "force_instrumental": true,
    "output_format": "mp3_48000_192"
   }
  }
 ]
}