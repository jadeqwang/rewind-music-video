{
 "model_id": "google/gemini-omni-1.1-flash",
 "name": "Gemini Omni Flash 1.1",
 "task": "Text-to-Video",
 "description": "High-performance multimodal video generation and editing model with conversational controls and generated audio.",
 "pricing": {
  "Input text tokens (per 1M)": 1.5,
  "Input image tokens (per 1M)": 1.5,
  "Input audio tokens (per 1M)": 1.5,
  "Input video tokens (per 1M)": 1.5,
  "output_text_tokens": 9,
  "Reasoning tokens (per 1M)": 9,
  "output_video_tokens": 17.5,
  "Default (per second)": 1.5
 },
 "metadata": {
  "Audio Generation": "Yes",
  "Input Modalities": "Text, image, audio, video",
  "Resolutions": "360p, 720p, 1080p, 4k"
 },
 "schema": {
  "input": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "text": {
     "description": "Text prompt or editing instruction",
     "type": "string"
    },
    "image": {
     "description": "First-frame or primary reference image",
     "type": "string"
    },
    "last_frame": {
     "description": "Last-frame reference image",
     "type": "string"
    },
    "reference_images": {
     "maxItems": 10,
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "video": {
     "description": "Reference video for editing or extension",
     "type": "string"
    },
    "audio": {
     "description": "Reference audio input",
     "type": "string"
    },
    "previous_interaction_id": {
     "type": "string"
    },
    "aspect_ratio": {
     "type": "string",
     "enum": [
      "16:9",
      "9:16"
     ]
    },
    "resolution": {
     "type": "string",
     "enum": [
      "360p",
      "720p",
      "1080p",
      "4k"
     ]
    }
   },
   "additionalProperties": false
  },
  "output": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "video": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^data:.*"
      },
      {
       "type": "string",
       "format": "uri"
      }
     ]
    }
   },
   "required": [
    "video"
   ],
   "additionalProperties": false
  }
 },
 "examples": [
  {
   "name": "Text to video",
   "input": {
    "text": "A marble rolling fast on a chain reaction style track, continuous smooth shot.",
    "aspect_ratio": "16:9",
    "resolution": "720p"
   }
  },
  {
   "name": "Portrait city",
   "input": {
    "text": "A futuristic city with neon lights and flying cars, cinematic camera movement and atmospheric haze.",
    "aspect_ratio": "9:16",
    "resolution": "720p"
   }
  },
  {
   "name": "Mountain sunrise",
   "input": {
    "text": "A drone shot flying over a mountain landscape at sunrise, golden light reflecting across a misty valley.",
    "aspect_ratio": "16:9",
    "resolution": "1080p"
   }
  },
  {
   "name": "Chain reaction",
   "input": {
    "text": "A marble rolling quickly along a wooden track, knocking through a playful chain reaction in one continuous shot.",
    "aspect_ratio": "16:9",
    "resolution": "360p"
   }
  }
 ]
}