{
 "model_id": "xai/grok-imagine-video",
 "name": "Grok Imagine Video",
 "task": "Text-to-Video",
 "description": "xAI's video generation model. Generates, edits, and extends videos from text and image inputs with native synchronized audio including dialogue, sound effects, and music. Supports multiple creative modes (normal, fun, custom).",
 "pricing": {
  "Default (per second)": 0.05,
  "@480p (per second)": 0.05,
  "@720p (per second)": 0.07
 },
 "metadata": {
  "Aspect Ratios": "1:1, 16:9, 9:16, 4:3, 3:4, 3:2, 2:3",
  "Input Modalities": "Text, Image, Video",
  "Max Duration": "15 seconds",
  "Resolutions": "480p, 720p"
 },
 "schema": {
  "input": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "_operation": {
     "type": "string",
     "enum": [
      "generate",
      "edit",
      "extend"
     ]
    },
    "prompt": {
     "type": "string"
    },
    "duration": {
     "type": "integer",
     "minimum": 1,
     "maximum": 15
    },
    "aspect_ratio": {
     "type": "string",
     "enum": [
      "1:1",
      "16:9",
      "9:16",
      "4:3",
      "3:4",
      "3:2",
      "2:3"
     ]
    },
    "resolution": {
     "type": "string",
     "enum": [
      "480p",
      "720p"
     ]
    },
    "size": {
     "type": "string",
     "enum": [
      "848x480",
      "1696x960",
      "1280x720",
      "1920x1080"
     ]
    },
    "image": {
     "type": "object",
     "properties": {
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "additionalProperties": false
    },
    "video": {
     "type": "object",
     "properties": {
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "additionalProperties": false
    },
    "reference_images": {
     "maxItems": 10,
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "url": {
        "type": "string"
       }
      },
      "required": [
       "url"
      ],
      "additionalProperties": false
     }
    },
    "output": {
     "type": "object",
     "properties": {
      "upload_url": {
       "type": "string"
      }
     },
     "required": [
      "upload_url"
     ],
     "additionalProperties": false
    },
    "user": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "output": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "video": {
     "type": "string"
    }
   },
   "required": [
    "video"
   ],
   "additionalProperties": false
  }
 },
 "examples": [
  {
   "name": "Simple Video",
   "input": {
    "prompt": "A golden retriever running through a field of sunflowers on a sunny day",
    "aspect_ratio": "16:9",
    "duration": 5,
    "resolution": "720p"
   }
  },
  {
   "name": "Portrait Video",
   "input": {
    "prompt": "Slow-motion close-up of ink drops blooming through water against a black background",
    "aspect_ratio": "9:16",
    "duration": 5,
    "resolution": "720p"
   }
  },
  {
   "name": "Cinematic Landscape",
   "input": {
    "prompt": "A wide drone shot over snow-covered mountain peaks at sunrise, dramatic lighting with low clouds",
    "aspect_ratio": "16:9",
    "duration": 10,
    "resolution": "720p"
   }
  }
 ]
}