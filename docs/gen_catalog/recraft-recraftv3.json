        91
       ]
      }
     ]
    }
   }
  },
  {
   "name": "Background Color",
   "input": {
    "prompt": "A clean icon of a lightning bolt",
    "controls": {
     "background_color": {
      "rgb": [
       245,
       245,
       245
      ]
     }
    },
    "size": "1024x1024"
   }
  }
 ]
}