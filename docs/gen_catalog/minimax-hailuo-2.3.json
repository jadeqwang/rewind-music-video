    "prompt_optimizer": true,
    "resolution": "768P"
   }
  },
  {
   "name": "Fast Processing",
   "input": {
    "prompt": "Fireworks exploding over a city skyline at night, colorful reflections on water",
    "duration": 6,
    "fast_pretreatment": true,
    "prompt_optimizer": true,
    "resolution": "768P"
   }
  }
 ]
}